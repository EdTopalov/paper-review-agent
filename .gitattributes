* text=auto eol=lf
# Hashes identify exact frozen bytes, including their original line endings.
*.json -text whitespace=cr-at-eol
*.jsonl -text whitespace=cr-at-eol
runs/** -text -whitespace
data/failures/** -text
# Pinned upstream notices retain original bytes; generators write explicit LF.
data/benchmark/** -text whitespace=cr-at-eol
